# General
# ------------------------------------------------------------------------------
# DJANGO_READ_DOT_ENV_FILE=True
# Never enable debug in production (default False).
# DJANGO_DEBUG=False
# Secrets kept out of git can also go in .envs/.secrets (optional; this file overrides it).
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET_KEY>
DJANGO_ADMIN_URL=<YOUR_ADMIN_URL_PATH>/
DJANGO_ALLOWED_HOSTS=<your-domain.com>
# Error-report recipients (ADMINS; MANAGERS gets the same list). Comma-separated,
# each "mail@example.com" or "Name <mail@example.com>" — no comma inside a name,
# it is the separator. Empty/unset = nobody gets the 500 emails.
# DJANGO_ADMINS=Jan Kowalski <admin@your-domain.com>
# Where collectstatic writes (default: /app/staticfiles).
# DJANGO_STATIC_ROOT=/app/staticfiles

# Security
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS. Defaults: 518400s (6-day ramp), includeSubDomains=True, preload=False.
# hstspreload.org rejects a `preload` directive with max-age < 31536000 (1 year),
# so only set DJANGO_SECURE_HSTS_PRELOAD=True together with a >= 1-year
# DJANGO_SECURE_HSTS_SECONDS — production settings refuse to start otherwise.
# Joining the browser preload list is hard to undo; do it once HTTPS is stable
# on every subdomain.
# DJANGO_SECURE_HSTS_SECONDS=518400
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False
# X-Content-Type-Options: nosniff (default True).
# DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# API
# ------------------------------------------------------------------------------
# Interactive OpenAPI docs at /api/docs (default True). Suggested: False in
# production — the docs page is public and lists every endpoint.
# DJANGO_API_ENABLE_DOCS=False

# Database
# ------------------------------------------------------------------------------
# Keep 0: the app runs under ASGI, where CONN_MAX_AGE > 0 leaves one idle
# connection behind per request thread and exhausts Postgres max_connections (#430).
# CONN_MAX_AGE=0

# Email (SMTP)
# ------------------------------------------------------------------------------
# Mail backend (default: the SMTP backend, configured by the DJANGO_EMAIL_* options below).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=Suchar Overflow <noreply@your-domain.com>
# DJANGO_SERVER_EMAIL=Suchar Overflow <noreply@your-domain.com>
# DJANGO_EMAIL_SUBJECT_PREFIX=[Suchar Overflow]
# DJANGO_EMAIL_HOST=smtp.your-provider.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=<your-smtp-user>
# DJANGO_EMAIL_HOST_PASSWORD=<your-smtp-password>
# DJANGO_EMAIL_USE_TLS=True          # STARTTLS, port 587
# DJANGO_EMAIL_USE_SSL=True          # implicit TLS / SMTPS, port 465 — mutually exclusive with DJANGO_EMAIL_USE_TLS
# DJANGO_EMAIL_TIMEOUT=5
# An empty DJANGO_EMAIL_* value counts as unset.

# Gunicorn
# ------------------------------------------------------------------------------
# Number of ASGI workers (gunicorn reads WEB_CONCURRENCY; default 1). Safe to raise:
# periodic jobs run in the single `cron` service (#462), not inside each web worker.
# WEB_CONCURRENCY=1

# Redis
# ------------------------------------------------------------------------------
# Required — settings and the entrypoint have no default for it.
REDIS_URL=redis://redis:6379/0
# RQ job queue (#460): a separate database from the cache, so a cache flush
# cannot delete pending jobs. Optional — defaults to REDIS_URL with the path /1.
REDIS_QUEUE_URL=redis://redis:6379/1
# Name of the RQ queue (#500). Optional, default `default`; letters, digits, `_`, `.`, `-` (not first).
# worker, cron and django read this one file, so they agree. Change it only after the old
# queue is drained and `cron` stopped: jobs still waiting under the old name are never run.
# DJANGO_RQ_QUEUE_NAME=default


# Feedback
# ------------------------------------------------------------------------------
FEEDBACK_URL=https://github.com/MilBia/Suchar-Overflow/issues/new
