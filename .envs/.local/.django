# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
DJANGO_SETTINGS_MODULE=config.settings.local
# Local-only development key (settings carry no default for it, #453).
DJANGO_SECRET_KEY=cyK4VvpwGM7EpstJLbiTOtPh2On3tyUNs9p331Yo38OPkiBqgiLCeLnjaNT5VPUi

# Email
# ------------------------------------------------------------------------------
# The mailpit container; its web UI is on localhost:8025.
DJANGO_EMAIL_HOST=mailpit
DJANGO_EMAIL_PORT=1025

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# RQ job queue (#460): its own database, apart from the cache above.
REDIS_QUEUE_URL=redis://redis:6379/1
# Name of the RQ queue (#500); worker, cron and django must all see the same value. Default: default.
# DJANGO_RQ_QUEUE_NAME=default
