{
    "name": "suchar-overflow-frontend",
    "version": "0.0.0",
    "private": true,
    "description": "Frontend toolchain: webpack + Babel + Sass + PostCSS builds the bundles Django serves (django-webpack-loader), plus the Vitest + jsdom test runner and the prettier version pin (kept equal to the pre-commit hook's). See CLAUDE.md 'Frontend pipeline'.",
    "type": "commonjs",
    "engines": {
        "node": ">=24"
    },
    "browserslist": [
        "last 2 versions"
    ],
    "scripts": {
        "dev": "webpack serve --config webpack/dev.config.js",
        "build": "webpack --config webpack/prod.config.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@babel/core": "^8.0.6",
        "@babel/preset-env": "^8.0.6",
        "autoprefixer": "^10.6.1",
        "babel-loader": "^10.1.1",
        "chart.js": "^4.5.1",
        "css-loader": "^7.1.5",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "flatpickr": "^4.6.13",
        "jsdom": "^30.1.1",
        "mini-css-extract-plugin": "^2.10.2",
        "postcss": "^8.5.28",
        "postcss-import": "^17.0.0",
        "postcss-loader": "^8.2.1",
        "postcss-preset-env": "^11.6.0",
        "prettier": "3.9.9",
        "sass": "^1.105.1",
        "sass-loader": "^17.0.1",
        "vitest": "^5.0.3",
        "webpack": "^5.111.1",
        "webpack-bundle-tracker": "^3.2.4",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1"
    }
}
