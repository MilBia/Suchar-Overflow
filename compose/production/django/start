#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

python /app/manage.py migrate --noinput
# --clear: the static volume (#463) outlives deploys, so drop files of past builds. The webpack
# bundles come from the image (the `client-builder` stage, #466), so collectstatic restores them.
python /app/manage.py collectstatic --noinput --clear

# --no-control-socket: since 25.1 gunicorn opens a control socket under
# $XDG_RUNTIME_DIR or $HOME/.gunicorn by default, and the system user `django`
# has no usable directory there (#456).
# Worker count comes from WEB_CONCURRENCY (gunicorn reads it; default 1) — see
# .envs/.production/.django.example before raising it.
exec gunicorn config.asgi:application \
  -k uvicorn.workers.UvicornWorker \
  --bind 0.0.0.0:5000 \
  --no-control-socket \
  --chdir /app
