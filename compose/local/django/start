#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python manage.py migrate
# *.mo is gitignored and the `.:/app` bind mount hides anything compiled into the
# image, so compile the catalogs here or a fresh clone renders raw msgids (#407).
# --ignore .venv: compilemessages walks every `locale` dir under cwd, including
# the installed packages' own catalogs, which it must not rewrite.
python manage.py compilemessages --ignore=.venv --ignore=node_modules
# Django caches loaded catalogs per process, so a recompiled .mo (`just messages`)
# must restart the worker too, not just a changed *.py.
# --timeout-graceful-shutdown: uvicorn's default is no timeout, so a reload with
# any `/achievements/stream/` SSE connection open waits for it forever — the
# reloader blocks joining the old worker and every new request hangs until the
# container is restarted (#403). SSE clients reconnect on their own (`retry:`).
exec uvicorn config.asgi:application --host 0.0.0.0 --port 8000 --reload \
  --reload-include "*.mo" --timeout-graceful-shutdown 3
