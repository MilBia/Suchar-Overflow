#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# `:-` so a completely unset POSTGRES_USER reaches this fallback instead of
# tripping `set -o nounset` first (the whole point of the block).
if [ -z "${POSTGRES_USER:-}" ]; then
    base_postgres_image_default_user='postgres'
    export POSTGRES_USER="${base_postgres_image_default_user}"
fi

# URL-encode the credential components before splicing them into the DSN. Today's
# generated user/password are alphanumeric, but a value containing @ : / % # ? would
# otherwise produce a silently malformed DATABASE_URL. Host/port are structural and
# left verbatim. `python3` is always on PATH in this image and cannot fail on a
# plain quote() call, so it is safe under `set -o errexit`. config/settings/base.py
# builds the same DSN itself when DATABASE_URL is absent (#453), so processes that
# skip this ENTRYPOINT (`docker compose exec`) still get a database.
_urlencode() {
    python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}
export DATABASE_URL="postgres://$(_urlencode "${POSTGRES_USER}"):$(_urlencode "${POSTGRES_PASSWORD}")@${POSTGRES_HOST}:${POSTGRES_PORT}/$(_urlencode "${POSTGRES_DB}")"
unset -f _urlencode

wait-for-it "${POSTGRES_HOST}:${POSTGRES_PORT}" -t 30

>&2 echo 'PostgreSQL is available'

# Parse host/port out of REDIS_URL (e.g. redis://[:password@]host[:port]/db, or
# rediss:// for TLS) the same way config/settings/base.py derives REDIS_SSL, so we
# wait on the exact host/port Django's cache backend (django_redis) will connect
# to instead of hardcoding the compose service name. The port is optional in the
# Redis URI spec (redis-py/django-redis default it to 6379), and a bracketed IPv6
# host (redis://[::1]:6379/0) must not be split on the colons inside the brackets.
# REDIS_URL has no default here or in settings: both env files set it (#453).
redis_url="${REDIS_URL:?REDIS_URL must be set in the .envs/.*/.django env file}"
if [[ "${redis_url}" =~ ^rediss?://([^/@]*@)?(\[[^]]+\]|[^:/]+)(:([0-9]+))? ]]; then
    REDIS_HOST="${BASH_REMATCH[2]}"
    REDIS_PORT="${BASH_REMATCH[4]:-6379}"
    # Strip the brackets an IPv6 host was matched with.
    REDIS_HOST="${REDIS_HOST#[}"
    REDIS_HOST="${REDIS_HOST%]}"
else
    >&2 echo "Could not parse host/port out of REDIS_URL=${redis_url}"
    exit 1
fi

wait-for-it "${REDIS_HOST}:${REDIS_PORT}" -t 30

>&2 echo 'Redis is available'

unset redis_url REDIS_HOST REDIS_PORT

exec "$@"
