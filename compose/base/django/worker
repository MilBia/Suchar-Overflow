#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# RQ worker for the `default` queue (#460). --with-scheduler runs RQ's own scheduler
# for enqueue_in/enqueue_at jobs and retry intervals (Retry(interval=...), #461);
# the periodic jobs themselves come from the separate `cron` service (#462).
exec python manage.py rqworker --with-scheduler default
